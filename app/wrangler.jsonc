{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "free4chat-realtime",
  "main": "worker.ts",
  "workers_dev": false,
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "free4chat-realtime" },
    // Same-zone Workers Routes cannot be called with global fetch. The Room
    // authority uses this binding for bounded catalog validation.
    {
      "binding": "ROOM_APP_CONTROL_PLANE",
      "service": "free4chat-room-app-control-plane"
    }
  ],
  // Observability stays on, but request URLs are persisted without their query
  // string. The SFU WebSocket bootstrap carries the participant bearer token in
  // query parameters (browsers cannot set headers on a WebSocket upgrade), and
  // invocation logs record "<method> <url>" — so without this, a participant
  // capability would be retained in Workers Logs. redact_query_string requires
  // wrangler >= 4.128.0; the transport itself is unchanged.
  "observability": { "enabled": true, "redact_query_string": true },
  // Explicitly empty: clears a stale Cron Trigger left over from the removed
  // legacy RTK cleanup handler. Without this, wrangler deploy leaves
  // whatever cron triggers already exist on the zone untouched, and
  // Cloudflare keeps invoking a scheduled() handler this Worker no longer
  // exports (per-room expiry is owned by each Durable Object's own alarm).
  "triggers": { "crons": [] },
  "vars": {
    // The production App ID is injected by GitHub Actions at deploy time.
    "SFU_APP_ID": "set-during-deployment",
    // Room Apps are an optional host capability; individual curated Apps are
    // supplied by the Lab-owned catalog while trust policy remains core-owned.
    "ROOM_APPS_ENABLED": "true"
  },
  "kv_namespaces": [
    {
      "binding": "ROOMS_KV",
      "id": "10ee56aaa9dd45eda179dfe709e1014a"
    }
  ],
  // #406: coarse pre-admission throttling for expensive/anonymous entry
  // points. Cloudflare Workers Rate Limiting is deliberately coarse and
  // per-location — it is a flood damper in front of Durable Object and
  // Cloudflare Realtime creation, never an exact global quota or an identity
  // system. It replaces the KV get/put counter on these paths, which was
  // itself a per-attempt cost amplifier. Limits here are the binding's
  // authoritative budget; the code-side KV fallback only applies when a
  // binding is absent (local unit tests).
  "ratelimits": [
    {
      // /api/sfu/session and /api/sfu/agent-session, keyed by IP + operation.
      "name": "SFU_ADMISSION_RATE_LIMITER",
      "namespace_id": "4601",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      // /mcp create_room and join_room admission.
      "name": "MCP_JOIN_RATE_LIMITER",
      "namespace_id": "4602",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Unauthenticated pre-DO probes: MCP room_info and /api/sfu/ws.
      "name": "ROOM_PROBE_RATE_LIMITER",
      "namespace_id": "4603",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SFU_ROOM",
        "class_name": "RoomSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["BotSession"]
    },
    {
      "tag": "v2",
      "new_classes": ["RoomSession"]
    },
    {
      "tag": "v3",
      "deleted_classes": ["BotSession"]
    }
  ]
}
