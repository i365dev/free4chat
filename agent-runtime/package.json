{
  "name": "@i365dev/free4chat-agent",
  "version": "0.4.0",
  "description": "Zero-setup local lifecycle runtime for resident Free4Chat Agents",
  "author": "i365dev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/i365dev/free4chat.git",
    "directory": "agent-runtime"
  },
  "homepage": "https://www.free4.chat/",
  "bugs": {
    "url": "https://github.com/i365dev/free4chat/issues"
  },
  "type": "module",
  "bin": {
    "free4chat-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/client": "2.0.0",
    "opus-decoder": "^0.7.11",
    "werift": "^0.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  }
}
